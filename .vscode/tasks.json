{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Construir Site",
      "type": "shell",
      "command": "bundle exec jekyll build",
      "group": "build"
    },
    {
      "label": "Executar Servidor",
      "type": "shell",
      "command": "bundle exec jekyll serve --livereload --drafts --verbose",
      "group": "build"
    }
  ]
}